# OpenAI API key, used by the AI Assistant container (approach A)
# and by the PII detection endpoint (approach B). Required.
OPENAI_API_KEY=
# Model used by approach B
OPENAI_MODEL=gpt-4.1-mini
# Nutrient Web SDK license key. Empty = evaluation mode (watermark).
NUTRIENT_WEB_LICENSE_KEY=
# Nutrient AI Assistant activation key. Empty = evaluation mode (1 hour per container start).
AIA_ACTIVATION_KEY=
PORT=4810
AIA_URL=http://localhost:4100
# Local-only secrets of the AI Assistant container and its database.
# Change them before you run the demo anywhere other than your own machine.
AIA_DB_PASSWORD=change-me
AIA_API_AUTH_TOKEN=change-me
AIA_DASHBOARD_PASSWORD=change-me
# Empty = a random value is generated at every start.
AIA_SECRET_KEY_BASE=
